{
  "name": "ai-booth-observer",
  "version": "1.0.0",
  "description": "Live multi-modal agentic AI system for STEM exhibition booths",
  "private": true,
  "keywords": [
    "ai",
    "multimodal",
    "cloudflare",
    "claude",
    "exhibition"
  ],
  "author": "jordan.burke@gmail.com",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:worker": "pnpm --filter worker dev",
    "dev:all": "concurrently \"pnpm --filter worker dev\" \"pnpm --filter frontend dev\" --names \"worker,frontend\" --prefix-colors \"blue,magenta\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "validate": "pnpm format && pnpm lint && pnpm test && pnpm build",
    "deploy": "pnpm --filter worker deploy && pnpm --filter frontend deploy"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
