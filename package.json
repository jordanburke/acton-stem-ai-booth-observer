{
  "name": "ai-booth-observer",
  "version": "1.0.0",
  "description": "Live multi-modal agentic AI system for STEM exhibition booths",
  "private": true,
  "keywords": [
    "ai",
    "multimodal",
    "cloudflare",
    "claude",
    "exhibition"
  ],
  "author": "jordan.burke@gmail.com",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:worker": "pnpm --filter worker dev",
    "dev:all": "concurrently \"pnpm --filter worker dev\" \"pnpm --filter frontend dev\" --names \"worker,frontend\" --prefix-colors \"blue,magenta\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "validate": "pnpm format && pnpm lint && pnpm test && pnpm build",
    "deploy": "pnpm --filter worker deploy && pnpm --filter frontend deploy"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
