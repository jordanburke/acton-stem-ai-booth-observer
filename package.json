{
  "name": "ai-booth-observer",
  "version": "1.0.0",
  "description": "Live multi-modal agentic AI system for STEM exhibition booths",
  "private": true,
  "keywords": [
    "ai",
    "multimodal",
    "cloudflare",
    "claude",
    "exhibition"
  ],
  "author": "jordan.burke@gmail.com",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "validate": "pnpm format && pnpm build && pnpm lint && pnpm test",
    "deploy": "pnpm --filter worker deploy && pnpm --filter frontend deploy"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
